# Environment variables template for AI Tech Consultant
# Copy this file to .env and fill in your values

# ===========================================
# ANTHROPIC API (Required - Claude is central)
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# Task 1 - Knowledge Brain Configuration
# ===========================================
KNOWLEDGE_BRAIN_HOST=0.0.0.0
KNOWLEDGE_BRAIN_PORT=8000
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
CRAWL_DELAY_SECONDS=2
CRAWL_CONCURRENCY=3
CRAWL_BATCH_SIZE=10

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI API key (for embeddings only, optional if using Anthropic-compatible)
OPENAI_API_KEY=your-openai-api-key-here

# Database
DATABASE_URL=sqlite:///./ai_tech_consultant.db
CHROMA_PERSIST_DIR=./chroma_db

# ===========================================
# Task 2 - Inbox Agent Configuration
# ===========================================
INBOX_AGENT_PORT=3000
KNOWLEDGE_BRAIN_URL=http://localhost:8000

# ===========================================
# Task 3 - Meeting to Scope Configuration
# ===========================================
MEETING_SCOPE_PORT=8001

# ===========================================
# General
# ===========================================
LOG_LEVEL=INFO
ENVIRONMENT=development
